{
    "cli": {
        "version": ">= 3.13.3",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "prebuildCommand": "node scripts/check-google-signin-sha.js"
        },
        "preview": {
            "distribution": "internal",
            "prebuildCommand": "node scripts/check-google-signin-sha.js",
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "prebuildCommand": "node scripts/check-google-signin-sha.js"
        }
    },
    "submit": {
        "production": {}
    }
}